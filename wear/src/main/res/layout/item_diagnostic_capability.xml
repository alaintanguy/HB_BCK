<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="#111111"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/measurement_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/measurement_availability"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#DDDDDD"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/measurement_api"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#DDDDDD"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/measurement_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#DDDDDD"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/measurement_current_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/measurement_last_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#DDDDDD"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/measurement_sampling"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#DDDDDD"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/measurement_restrictions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FFCC80"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/measurement_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#BBBBBB"
        android:textSize="11sp" />

</LinearLayout>
