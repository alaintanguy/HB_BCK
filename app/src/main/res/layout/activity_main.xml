<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ========================
         CONVERSATION MODE
         ======================== -->
    <LinearLayout
        android:id="@+id/conversationModeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Google Map (top half) -->
        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Status Line -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000000"
            android:text="🟢 ONLINE    🕒 --:--    🔋 --%"
            android:textColor="#FFFF00"
            android:textStyle="bold"
            android:textSize="14sp"
            android:padding="6dp"
            android:gravity="center"/>

        <!-- Scrollable conversation history -->
        <ScrollView
            android:id="@+id/conversationScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/conversationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </ScrollView>

        <!-- Bottom action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp"
            android:background="#1a1a1a">

            <!-- Circular Write button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnWrite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:contentDescription="Write"
                app:srcCompat="@android:drawable/ic_menu_edit"
                app:backgroundTint="#FFD700" />

            <!-- Circular Microphone button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:contentDescription="Microphone"
                app:srcCompat="@android:drawable/ic_menu_send"
                app:backgroundTint="#FFD700" />

            <!-- Copy button placeholder (future) -->
            <View
                android:id="@+id/btnCopyPlaceholder"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="8dp"
                android:visibility="invisible" />

            <!-- Save button placeholder (future) -->
            <View
                android:id="@+id/btnSavePlaceholder"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="8dp"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========================
         COMPOSE MODE
         ======================== -->
    <LinearLayout
        android:id="@+id/composeModeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#000000"
        android:visibility="gone">

        <!-- Fixed 6-line compose editor -->
        <EditText
            android:id="@+id/composeEditor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="6"
            android:maxLines="6"
            android:minLines="6"
            android:inputType="textMultiLine|textCapSentences"
            android:gravity="top|start"
            android:background="#1a1a1a"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:hint="Type your message..."
            android:padding="12dp"
            android:textSize="16sp" />

        <!-- Send button -->
        <Button
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Send"
            android:textColor="#000000"
            android:backgroundTint="#FFD700"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>